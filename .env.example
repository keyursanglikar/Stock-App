# ==============================================================================
# StockWise Environment Configuration (100% Free / Community Edition)
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=stockwise-super-secret-production-grade-key-replace-in-prod-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOW_ALL_ORIGINS=True

# Database (MySQL 8)
DB_NAME=stockwise_db
DB_USER=stockwise_user
DB_PASSWORD=stockwise_secure_pass_2026
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (Cache, OTP Store, Celery Broker)
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Google Gemini AI Vision (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash


# Media & Storage (AWS S3 or Local)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=stockwise-media
AWS_S3_REGION_NAME=ap-south-1

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# SMS OTP Provider (Optional for testing; defaults to mock OTP 123456 in dev mode)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
